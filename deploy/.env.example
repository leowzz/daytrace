DAYTRACE_BIND_ADDRESS=0.0.0.0
DAYTRACE_PORT=8000
DAYTRACE_ASR_BACKEND=faster-whisper
DAYTRACE_ASR_MODEL=small
DAYTRACE_ASR_DEVICE=cpu
DAYTRACE_ASR_COMPUTE_TYPE=int8
DAYTRACE_ASR_CPU_THREADS=8
DAYTRACE_ASR_NUM_WORKERS=1
DAYTRACE_MAX_UPLOAD_BYTES=134217728
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# If the host cannot reach the model mirror directly, set these in the deployment .env.
# HTTP_PROXY=http://192.168.177.20:7890
# HTTPS_PROXY=http://192.168.177.20:7890
# NO_PROXY=localhost,127.0.0.1,hf-mirror.com
